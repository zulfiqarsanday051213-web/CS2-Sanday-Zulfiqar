# Electricity Bill Calculator
RATE = 12.90

while True: 
    name = input("Enter customer name: ").strip()
    if name != "":
        break
    print("Error: Customer name cannot be empty. Please try again.")
    
while True:
    try:
        previous = float(input("Enter previous meter reading: "))
        if previous >= 0:
            break
        print("Error: Previous reading must at least be 0. Please try again.")
    except ValueError:
        print("Error: Invalid input. Please enter a valid number.")
    
while True:
    try:
        current = float(input("Enter current meter reading: "))
        if current >= previous:
            break
        print("Error: Previous reading must at least be 0. Please try again.")
    except ValueError:
        print("Error: Invalid input. Please enter a valid number.")
 
consumption = current - previous
total_bill = consumption * RATE

print("\nCustomer:", name)
print("Electricity Consumption:", consumption, "kWh")
print("Total Bill: PHP", round(total_bill, 2))

# Validation rules
# 1. Customer name -- Must not be empty
# 2. Previous reading -- Number at least 0
# 3. Current reading -- Number at least the previous reading
